<section class="hero on-dark grain is-lit pw-hero" data-oil>
  <div class="oil-field" aria-hidden="true"><span></span><span></span><span></span><span></span></div>
  <div class="shell hero-inner">
    <p class="brand display">{{ 'content.brand' | t }}</p>
    <h1 class="display hero-title"><span>{{ 'general.password_title' | t }}</span></h1>
    {%- if shop.password_message != blank -%}
      <p class="hero-lede measure">{{ shop.password_message }}</p>
    {%- else -%}
      <p class="hero-lede measure">{{ 'content.hero.lede' | t }}</p>
    {%- endif -%}

    {%- form 'customer', class: 'pw-form' -%}
      <input type="hidden" name="contact[tags]" value="prospect,password-page">
      {%- if form.posted_successfully? -%}
        <p class="done-title" role="status">{% render 'icon', name: 'check', size: 18 %}<span>{{ 'general.newsletter_done' | t }}</span></p>
      {%- else -%}
        <p class="field">
          <label for="pw-email">{{ 'general.newsletter_label' | t }}</label>
          <input id="pw-email" type="email" name="contact[email]" autocomplete="email" required>
        </p>
        <button class="btn btn-primary" type="submit">{{ 'general.newsletter_submit' | t }}</button>
        {{ form.errors | default_errors }}
      {%- endif -%}
    {%- endform -%}

    <details class="pw-login">
      <summary>{{ 'general.password_enter' | t }}</summary>
      {%- form 'storefront_password', class: 'pw-form' -%}
        <p class="field">
          <label for="pw">{{ 'general.password_label' | t }}</label>
          <input id="pw" type="password" name="password" autocomplete="current-password" required>
        </p>
        <button class="btn btn-quiet" type="submit">{{ 'general.password_submit' | t }}</button>
        {{ form.errors | default_errors }}
      {%- endform -%}
    </details>
  </div>
</section>

{% schema %}
{ "name": "Mot de passe", "class": "section-main-password", "settings": [] }
{% endschema %}
