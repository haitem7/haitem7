<section class="band band-paper">
  <div class="shell acct">
    <div class="acct-panel">
      <h1 class="display sec-title">{{ 'customer.register' | t }}</h1>
      {%- form 'create_customer', novalidate: 'novalidate' -%}
        {{ form.errors | default_errors }}
        <div class="fields acct-fields">
          <p class="field">
            <label for="r-first">{{ 'customer.first_name' | t }}</label>
            <input id="r-first" type="text" name="customer[first_name]" autocomplete="given-name">
          </p>
          <p class="field">
            <label for="r-last">{{ 'customer.last_name' | t }}</label>
            <input id="r-last" type="text" name="customer[last_name]" autocomplete="family-name">
          </p>
          <p class="field field-wide">
            <label for="r-email">{{ 'customer.email' | t }}</label>
            <input id="r-email" type="email" name="customer[email]" autocomplete="email" required>
          </p>
          <p class="field field-wide">
            <label for="r-password">{{ 'customer.password' | t }}</label>
            <input id="r-password" type="password" name="customer[password]" autocomplete="new-password" required>
          </p>
        </div>
        <p class="acct-actions"><button class="btn btn-primary" type="submit">{{ 'customer.create' | t }}</button></p>
      {%- endform -%}
    </div>
  </div>
</section>
