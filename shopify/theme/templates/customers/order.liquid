<section class="band band-paper">
  <div class="shell">
    <p class="pdp-crumb"><a href="{{ routes.account_url }}">{{ 'customer.back_account' | t }}</a></p>
    <h1 class="display sec-title">{{ 'customer.order' | t }} {{ order.name }}</h1>
    <p class="doc-date tnum">{{ order.created_at | time_tag: format: 'date_at_time' }}</p>
    {%- if order.cancelled -%}
      {%- assign cancelled_on = order.cancelled_at | date: format: 'date' -%}
      <p class="summary">{{ 'customer.cancelled' | t: date: cancelled_on }}</p>
    {%- endif -%}

    <div class="scroll-x">
      <table class="spec">
        <thead>
          <tr>
            <th scope="col">{{ 'cart_page.product' | t }}</th>
            <th scope="col">{{ 'customer.sku' | t }}</th>
            <th scope="col">{{ 'cart_page.price' | t }}</th>
            <th scope="col">{{ 'customer.qty' | t }}</th>
            <th scope="col">{{ 'customer.total' | t }}</th>
          </tr>
        </thead>
        <tbody>
          {%- for li in order.line_items -%}
            <tr>
              <th scope="row">{{ li.title }}</th>
              <td>{{ li.sku }}</td>
              <td class="tnum">{{ li.final_price | money }}</td>
              <td class="tnum">{{ li.quantity }}</td>
              <td class="tnum">{{ li.final_line_price | money }}</td>
            </tr>
          {%- endfor -%}
        </tbody>
      </table>
    </div>

    <dl class="datagrid facts-grid acct-sum">
      <div><dt>{{ 'customer.subtotal' | t }}</dt><dd class="tnum">{{ order.line_items_subtotal_price | money }}</dd></div>
      {%- for s in order.shipping_methods -%}
        <div><dt>{{ 'customer.shipping' | t }} — {{ s.title }}</dt><dd class="tnum">{{ s.price | money }}</dd></div>
      {%- endfor -%}
      <div><dt>{{ 'customer.total' | t }}</dt><dd class="tnum">{{ order.total_price | money_with_currency }}</dd></div>
    </dl>

    <div class="acct-grid">
      {%- if order.shipping_address -%}
        <div>
          <h2 class="sub-title">{{ 'customer.shipping_address' | t }}</h2>
          <address class="foot-addr">{{ order.shipping_address | format_address }}</address>
        </div>
      {%- endif -%}
      <div>
        <h2 class="sub-title">{{ 'customer.billing' | t }}</h2>
        <address class="foot-addr">{{ order.billing_address | format_address }}</address>
      </div>
    </div>
  </div>
</section>
