{%- liquid
  assign t = page_title
  if t == blank
    assign t = shop.name
  endif
  if current_tags
    assign t = t | append: ' – ' | append: current_tags.first
  endif
  if current_page != 1
    assign t = t | append: ' – ' | append: current_page
  endif
  unless page_title contains shop.name
    assign t = t | append: ' — ' | append: shop.name
  endunless

  assign d = page_description
  if d == blank
    assign d = 'content.meta_description' | t
  endif

  assign og_type = 'website'
  if request.page_type == 'product'
    assign og_type = 'product'
  elsif request.page_type == 'article'
    assign og_type = 'article'
  endif
-%}
<title>{{ t }}</title>
<meta name="description" content="{{ d | escape }}">
<meta property="og:site_name" content="{{ shop.name | escape }}">
<meta property="og:url" content="{{ canonical_url }}">
<meta property="og:title" content="{{ t | escape }}">
<meta property="og:type" content="{{ og_type }}">
<meta property="og:description" content="{{ d | escape }}">
<meta property="og:locale" content="{{ request.locale.iso_code | replace: '-', '_' }}">
{%- if page_image -%}
  <meta property="og:image" content="https:{{ page_image | image_url: width: 1200 }}">
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="{{ 1200 | divided_by: page_image.aspect_ratio | round }}">
  <meta name="twitter:card" content="summary_large_image">
{%- else -%}
  <meta property="og:image" content="https:{{ 'hero-poster.jpg' | asset_url }}">
  <meta name="twitter:card" content="summary_large_image">
{%- endif -%}
{%- if request.page_type == 'product' and product.price > 0 -%}
  <meta property="og:price:amount" content="{{ product.price | money_without_currency | strip_html }}">
  <meta property="og:price:currency" content="{{ cart.currency.iso_code }}">
{%- endif -%}
{%- comment -%} hreflang links are injected by Shopify through content_for_header for every published language. {%- endcomment -%}
