  "process": {
    "id": "process",
    "title": "من الشجرة إلى الخزان",
    "lede": "ست عمليات، بالترتيب. لكل واحدة قيد زمني أو حراري، وهناك تُحسم جودة الدفعة.",
    "steps": [
      {
        "title": "الجمع",
        "body": "أمشاط هوائية وشِباك أرضية. ينزل الزيتون في صناديق مثقّبة بوزن 22 كغ، لا في أكياس: الكيس يسحق الحبّة ويرفع الحموضة قبل الوصول إلى المعصرة.",
        "tag": "≤ 6 ساعات إلى المعصرة"
      },
      {
        "title": "الاستلام والغسل",
        "body": "وزن، إزالة الأوراق، غسل بالماء البارد. كل توريد يأخذ رقم دفعة يلازم الزيت إلى غاية الحاوية.",
        "tag": "فتح الدفعة"
      },
      {
        "title": "الطحن",
        "body": "مطحنة مطارق من الفولاذ المقاوم للصدأ، بتدفق متواصل. تُشكَّل العجينة بأقل تعرّض ممكن للهواء.",
        "tag": "فولاذ مقاوم للصدأ"
      },
      {
        "title": "الخضّ",
        "body": "أربعون دقيقة تحت النيتروجين، 26 درجة كحد أقصى. الحرارة الأعلى تربح مردودًا وتخسر العبق: ونحن نرجّح العبق.",
        "tag": "26 °م كحد أقصى"
      },
      {
        "title": "الاستخلاص",
        "body": "جهاز فصل طردي ثنائي الطور. بلا ماء مضاف، فلا بوليفينولات مغسولة ولا مياه نفايات لمعالجتها.",
        "tag": "ثنائي الطور"
      },
      {
        "title": "التخزين",
        "body": "خزانات فولاذية بسعة 12000 لتر تحت غلاف نيتروجيني، على 16 درجة، في العتمة. التعليب يتم عند الطلب، لا مسبقًا.",
        "tag": "16 °م، تحت النيتروجين"
      }
    ]
  },
